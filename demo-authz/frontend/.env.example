VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_SENTINEL_URL=http://localhost:9003
# Backend proxy URL — SentinelAuthz mints authz tokens via ${VITE_BACKEND_URL}/auth/mint
# (not directly against Sentinel) so the service key stays server-side.
VITE_BACKEND_URL=http://localhost:9200
